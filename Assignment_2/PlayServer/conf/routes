# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index
GET    /explore                     controllers.HomeController.explore
GET    /tutorial                    controllers.HomeController.tutorial

GET     /test/:firebaseId           controllers.HomeController.test(firebaseId:String)
# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

# Positioning
POST    /position/:firebaseId/:latitude/:longitude/update   controllers.HomeController.updateUserLocation(firebaseId: String,latitude:Double,longitude:Double)
GET     /position/:firebaseId/getAllPositions               controllers.HomeController.getAllLocations(firebaseId: String)
GET     /remoteTest                                         controllers.HomeController.remoteTest
GET	    /deployTest				                            controllers.HomeController.deployTest
# User
GET     /user/:firebaseId/getNearbyUsers                    controllers.HomeController.getNearbyUsers(firebaseId:String)
GET     /user/:firebaseId/getUser                           controllers.HomeController.getUser(firebaseId:String)
GET     /user/:nickName/getUserByNickName                   controllers.HomeController.getUserByNickName(nickName:String)
GET     /user/:firebaseId/getFriendList                     controllers.HomeController.getFriendList(firebaseId:String)

GET     /puzzle/:puzzleId/getPuzzle                         controllers.HomeController.getPuzzle(puzzleId:String)

POST    /user/:userString/update                            controllers.HomeController.updateUser(userString: String)
POST    /user/:firebaseId/prepare                           controllers.HomeController.prepareUser(firebaseId:String)
POST    /user/:firebaseId/:nickName/prepare                  controllers.HomeController.prepareUserWithNickname(firebaseId:String,nickName:String)
GET     /user/:firebaseIdMe/:firebaseIdFriend/prepareFriend     controllers.HomeController.prepareFriendship(firebaseIdMe:String,firebaseIdFriend:String)
